# ==============================================================================
# Docker 构建上下文忽略清单
# 避免将本地缓存、构建中间产物及机密信息发送到 Docker 守护进程
# ==============================================================================

# 版本控制与 CI
.git
.github
.gitignore
.dockerignore

# 操作系统与 IDE
.DS_Store
Thumbs.db
.idea
.vscode

# 敏感文件与本地环境变量
.env
.env.*
!.env.example

# 日志
*.log
logs

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java
target/
.gradle/
build/
bin/
*.class

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Go / 可执行文件
*.exe
/bin
